<Window x:Class="MicroGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MicroGui"
        Title="MicroGui" Icon="pack://application:,,,/MicroGui;component/Resources/App.ico"
        SizeToContent="WidthAndHeight" MinWidth="480"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <!-- Test Plan panel -->
        <GroupBox Grid.Row="0" Header="Test Plan" Margin="8">
            <StackPanel Margin="6">
                <DockPanel Margin="0,0,0,8">

                    <!-- Browse button -->
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right"
                            Padding="10,5" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MicroGui;component/Resources/OpenFolder.64.png"
                                Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" />
                            <TextBlock Text="Browse..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- TapPlan file path -->
                    <Grid Margin="0,0,8,0">
                        <TextBox x:Name="PlanPathBox"
                                AutomationProperties.Name="Test plan path (.TapPlan)"
                                TextChanged="PlanPathBox_TextChanged"
                                KeyDown="PlanPathBox_KeyDown"
                                LostFocus="PlanPathBox_LostFocus"
                                VerticalContentAlignment="Center" />
                        <TextBlock Text="No plan loaded" Margin="6,0,0,0"
                                VerticalAlignment="Center" Foreground="Gray"
                                IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PlanPathBox}"
                                                    Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </DockPanel>
                <StackPanel Orientation="Horizontal">

                    <!-- Start button -->
                    <Button x:Name="StartButton"
                            Padding="18,5" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MicroGui;component/Resources/Play.64.png"
                                Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop button -->
                    <Button x:Name="StopButton"
                            Padding="18,5" Margin="8,0,0,0" Click="Stop_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MicroGui;component/Resources/Stop.64.png"
                                Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- State status-->
                    <TextBlock x:Name="StateText" Margin="18,0,0,0"
                            VerticalAlignment="Center" Text="Idle" />

                    <!-- Verdict status -->
                    <TextBlock x:Name="VerdictText" Margin="18,0,0,0"
                            VerticalAlignment="Center" Text="Verdict: -" />

                </StackPanel>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>
