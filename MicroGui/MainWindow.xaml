<Window x:Class="MicroGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicroGui" Icon="pack://application:,,,/MicroGui;component/Resources/App.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Button icon style -->
        <Style x:Key="ButtonIconStyle" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- Test Plan panel -->
        <GroupBox Grid.Row="0" Header="Test Plan" Margin="8">
            <StackPanel Margin="6">
                <DockPanel Margin="0,0,0,8">

                    <!-- Browse button -->
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right"
                            Padding="10,5" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MicroGui;component/Resources/OpenFolder.64.png"
                                   Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Browse..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- TapPlan file path -->
                    <Grid Margin="0,0,8,0">
                        <TextBox x:Name="PlanPathBox"
                                AutomationProperties.Name="Test plan path (.TapPlan)"
                                TextChanged="PlanPathBox_TextChanged"
                                KeyDown="PlanPathBox_KeyDown"
                                LostFocus="PlanPathBox_LostFocus"
                                VerticalContentAlignment="Center" />
                        <TextBlock Text="No plan loaded" Margin="6,0,0,0"
                                VerticalAlignment="Center" Foreground="Gray"
                                IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PlanPathBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                </DockPanel>
                <StackPanel Orientation="Horizontal">

                    <!-- Start button -->
                    <Button x:Name="StartButton"
                            Padding="18,5" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MicroGui;component/Resources/Play.64.png"
                                   Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Stop button -->
                    <Button x:Name="StopButton"
                            Padding="18,5" Margin="8,0,0,0" Click="Stop_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/MicroGui;component/Resources/Stop.64.png"
                                   Style="{StaticResource ButtonIconStyle}" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- State status-->
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">

                        <!-- Activity ring, shown only while Running or Stopping; Hidden (not Collapsed) keeps its slot reserved -->
                        <Path x:Name="ActivityRing" Width="14" Height="14" Margin="0,0,6,0"
                              VerticalAlignment="Center" Visibility="Hidden"
                              Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                              Data="M 7,1 A 6,6 0 1 1 1,7">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ActivityRingRotation" Angle="0" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Hidden longest-text sizers reserve a stable width for the state label -->
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="No plan loaded" Visibility="Hidden" />
                            <TextBlock Text="Stopping after 9999.99 s" Visibility="Hidden" />
                            <TextBlock Text="Completed in 9999.99 s" Visibility="Hidden" />
                            <TextBlock Text="Aborted after 9999.99 s" Visibility="Hidden" />
                            <TextBlock Text="Failed after 9999.99 s" Visibility="Hidden" />
                            <TextBlock x:Name="StateText" Text="Idle" />
                        </Grid>
                    </StackPanel>

                    <!-- Verdict status; hidden sizer reserves width for the longest OpenTAP verdict -->
                    <Grid Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Verdict: Inconclusive" Visibility="Hidden" />
                        <TextBlock x:Name="VerdictText" Text="Verdict: -" />
                    </Grid>

                </StackPanel>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>
