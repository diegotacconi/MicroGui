<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <Deterministic>True</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Assembly version, shown in the title bar when running from build output.
         The PACKAGE version is defined in .gitversion (source of truth) and is
         stamped over this at install time via <SetAssemblyInfo> in package.xml.
         Keep the base value in sync with .gitversion so dev builds match. -->
    <Version>0.0.3</Version>
    <OpenTapPackageDefinitionPath>package.xml</OpenTapPackageDefinitionPath>
    <CreateOpenTapPackage>true</CreateOpenTapPackage>
    <InstallCreatedOpenTapPackage>false</InstallCreatedOpenTapPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTAP" Version="9.21.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\App.ico" />
    <Resource Include="Resources\OpenFolder.64.png" />
    <Resource Include="Resources\Play.64.png" />
    <Resource Include="Resources\Stop.64.png" />
  </ItemGroup>

</Project>